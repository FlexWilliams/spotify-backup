{
	"name": "spotify-backup",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"build": {
		"command": "npm run build:prod"
	},
	"compatibility_date": "2025-01-01",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"compatibility_flags": ["nodejs_compat"]
}
